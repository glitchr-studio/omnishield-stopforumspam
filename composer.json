{
    "name": "omnishield/stopforumspam",
    "type": "library",
    "description": "Omnishield StopForumSpam: are this IP address, this e-mail (sent hashed), this name reported for abuse - the public database's frequency, confidence and last sighting, a threshold of the site's; reports with an API key.",
    "keywords": [
        "spam",
        "antispam",
        "stopforumspam",
        "reputation",
        "blocklist",
        "omnishield"
    ],
    "homepage": "https://github.com/glitchr-studio/omnishield-stopforumspam",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnishield": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnishield\\Stopforumspam\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnishield\\Stopforumspam\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
